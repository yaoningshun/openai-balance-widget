<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><AssemblyName>Saldo</AssemblyName><RootNamespace>Saldo</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><OutputPath>dist\</OutputPath>
    <ApplicationManifest>src\app.manifest</ApplicationManifest><ApplicationIcon>assets\saldo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Net.Http"/>
    <Reference Include="System.Web.Extensions"/><Reference Include="System.Security"/><Reference Include="System.Drawing"/>
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Xaml"/><Reference Include="WindowsBase"/>
    <Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/>
    <Compile Include="src\App.cs"/><Compile Include="src\Core.cs"/><Compile Include="src\Storage.cs"/>
    <EmbeddedResource Include="src\View.xaml"><LogicalName>Saldo.View.xaml</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
